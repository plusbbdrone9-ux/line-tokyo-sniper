# ==========================================
# Unified LINE Bot Hub Configuration
# ==========================================

# 1. AI Configuration (Google Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"

# 2. LINE Official Account (LINE OA) Settings
# ดูได้จาก LINE Developers Console (https://developers.line.biz/)
LINE_OA_CHANNEL_SECRET=""
LINE_OA_CHANNEL_ACCESS_TOKEN=""

# 3. LINE Personal Bridge Settings
PERSONAL_BRIDGE_SECRET="secret-token-for-bridge"
PERSONAL_MODE="android" # 'android' หรือ 'desktop'

# 4. Human Takeover & Cooldowns
AUTO_REPLY_ENABLED=True
HUMAN_TAKEOVER_TIMEOUT_MINUTES=20
REPLY_DELAY_SECONDS=1.0

# 5. Server Settings
APP_HOST="0.0.0.0"
APP_PORT=8000
DATABASE_PATH="data/line_bot.db"
